APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=runtime/orchestrator.sqlite3
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_BYTES=262144000
OPENAI_API_KEY=
OPENAI_COORDINATOR_MODEL=gpt-5.6-terra
OPENAI_WORKER_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_MAX_REQUESTS_PER_RUN=5
OPENAI_MAX_OUTPUT_TOKENS_PER_RUN=12000
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
MCP_CALENDAR_TOOL=create_calendar_event
MCP_TASK_TOOL=create_task
MCP_LOOKUP_TOOL=find_action_by_idempotency_key
TRACE_INCLUDE_SENSITIVE_DATA=false
